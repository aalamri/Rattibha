{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "customer-web",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["expo", "start", "--web", "--offline"],
      "port": 8081,
      "cwd": "apps/customer"
    },
    {
      "name": "customer-device",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["expo", "start", "--clear"],
      "port": 8082,
      "cwd": "apps/customer"
    },
    {
      "name": "planner",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 3000,
      "autoPort": true,
      "cwd": "apps/planner"
    },
    {
      "name": "website",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 3001,
      "cwd": "apps/website"
    }
  ]
}
